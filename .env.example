# TiDB Cloud Production Database Connection
TIDB_HOST=gateway01.us-west-2.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=4CfgwWN4niqXLXF.root
TIDB_PASSWORD=your_tidb_password_here
TIDB_DATABASE=campus_dive
TIDB_SSL_REJECT_UNAUTHORIZED=true

# Allow only the deployed Aggrey campaign website origin, e.g. https://aggrey.example
CLASS_REP_ALLOWED_ORIGINS=https://cpatum.netlify.app
# Separate high-entropy token used only for class rep review access
CLASS_REP_REVIEW_TOKEN=

# Africa's Talking / Kenyan Bulk SMS Gateway Configuration
AT_USERNAME=sandbox
AT_USERNAME=your_at_username_here
AT_API_KEY=your_africastalking_api_key_here
AT_SENDER_ID=ELISHA2026
# Optional alphanumeric sender ID (leave empty if not yet registered/approved by telcos)
AT_SENDER_ID=
SMS_ENABLED=false
SMS_PROVIDER=africastalking
NEXT_PUBLIC_SMS_SENDER_ID=ELISHA2026
NEXT_PUBLIC_SMS_SENDER_ID=
